---
import { getCollection } from 'astro:content';
import ArticlePage from '../../components/ArticlePage.astro';
import { articleSlug } from '../../articles';
export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft && data.lang === 'zh');
  return articles.map(article => ({ params: { slug: articleSlug(article) }, props: { article } }));
}
---
<ArticlePage article={Astro.props.article} />
