---
import { siteConfig } from '../config';
import { langPath, type Lang } from '../i18n';
import PasswordGate from '../components/PasswordGate.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import '../styles/global.css';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  /** Canonical path for non-homepage pages (e.g. `/articles/foo/`). */
  path?: string;
  /** null omits image metadata for records without a representative image. */
  ogImage?: string | null;
  ogType?: string;
  noindex?: boolean;
  /** Overrides the default LocalBusiness JSON-LD (e.g. Article schema). */
  jsonLd?: object;
}

const { lang = 'zh', path, ogType = 'website', jsonLd } = Astro.props;
const {
  title = lang === 'zh' ? siteConfig.titleZh : siteConfig.title,
  description = lang === 'zh' ? siteConfig.descriptionZh : siteConfig.description,
} = Astro.props;
const ogImage = Astro.props.ogImage === null
  ? null
  : Astro.props.ogImage ?? `${siteConfig.url}/images/george-zhou.jpg`;
const canonical = `${siteConfig.url}${path ?? langPath(lang)}`;
const isHomepage = !path;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {import.meta.env.PROD && !siteConfig.isDraft && !Astro.props.noindex && <GoogleAnalytics />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {isHomepage && (
      <>
        <link rel="alternate" hreflang="zh" href={`${siteConfig.url}/`} />
        <link rel="alternate" hreflang="en" href={`${siteConfig.url}/en/`} />
        <link rel="alternate" hreflang="x-default" href={`${siteConfig.url}/`} />
      </>
    )}

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {(siteConfig.isDraft || Astro.props.noindex) && <meta name="robots" content="noindex, nofollow" />}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": siteConfig.name,
      "description": description,
      "url": canonical,
      ...(siteConfig.phone ? { "telephone": siteConfig.phone } : {}),
      "email": siteConfig.email,
      "image": ogImage,
      "areaServed": siteConfig.serviceAreas.map(area => ({
        "@type": "AdministrativeArea",
        "name": `${area} County, CA`
      })),
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "addressRegion": "CA",
        "addressCountry": "US"
      }
    }).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <PasswordGate />
    <slot />
  </body>
</html>
