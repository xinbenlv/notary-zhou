---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import { siteConfig } from '../../config';
import type { Lang } from '../../i18n';
import { getPool } from '../../lib/booking/db';

interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';

const sessionId = Astro.url.searchParams.get('session') ?? '';
type Row = {
  id: string; status: string; starts_at: string; location_kind: string;
  address: string | null; total_cents: number; email: string | null;
};
let booking: Row | null = null;
if (sessionId && /^cs_[A-Za-z0-9_]+$/.test(sessionId)) {
  try {
    const { rows } = await getPool().query<Row>(
      `SELECT id, status, starts_at, location_kind, address, total_cents, email
         FROM bookings WHERE checkout_session_id = $1`, [sessionId]);
    booking = rows[0] ?? null;
  } catch { booking = null; }
}

const fmt = (iso: string) => new Intl.DateTimeFormat(zh ? 'zh-CN' : 'en-US', {
  timeZone: 'America/Los_Angeles', dateStyle: 'full', timeStyle: 'short',
}).format(new Date(iso));

// webhook 可能还没跑完就跳回来了：那是正常的，不是失败
const pending = !booking || booking.status === 'held';
const t = {
  title: zh ? `预约已确认 | ${siteConfig.nameZh}` : `Booking confirmed | ${siteConfig.name}`,
  h1: pending ? (zh ? '正在确认您的预约…' : 'Confirming your booking…')
              : (zh ? '预约已确认' : 'Booking confirmed'),
  pendingNote: zh
    ? '付款已收到，正在写入日程。这个页面不需要一直开着——确认邮件会发到您在收银台填写的邮箱。'
    : 'Payment received and we are writing it to the calendar. You can close this page — the confirmation goes to the email you entered at checkout.',
  holdNote: zh
    ? '款项目前只是预授权（冻结），公证完成后才会实际扣款；届时按实际公证的签名处数结算，可能少于此金额。'
    : 'The amount is only authorized (held) for now. We charge after the notarization is completed, based on the signatures actually notarized — it may come to less than this.',
  contact: zh ? '有问题请来信 ' : 'Questions? Email ',
  back: zh ? '返回首页' : 'Back to home',
};
---
<Layout lang={lang} title={t.title} description="" path={zh ? '/booked/' : '/en/booked/'} noindex>
  <Navbar lang={lang} />
  <main class="booked">
    <div class="card">
      <h1>{t.h1}</h1>
      {booking && !pending && (
        <dl>
          <div><dt>{zh ? '订单号' : 'Booking'}</dt><dd>{booking.id}</dd></div>
          <div><dt>{zh ? '时间' : 'Time'}</dt><dd>{fmt(booking.starts_at)}</dd></div>
          <div><dt>{zh ? '地点' : 'Location'}</dt>
            <dd>{booking.location_kind === 'park' ? 'Sunnyvale Lakewood Park' : booking.address}</dd></div>
          <div><dt>{zh ? '预授权金额' : 'Authorized'}</dt><dd>${(booking.total_cents / 100).toFixed(2)}</dd></div>
        </dl>
      )}
      <p class="note">{pending ? t.pendingNote : t.holdNote}</p>
      <p class="note">{t.contact}<a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
      <a class="btn" href={zh ? '/' : '/en/'}>{t.back}</a>
    </div>
  </main>
  <Footer lang={lang} />
</Layout>

<style>
  .booked { padding-top: calc(var(--nav-height) + 48px); padding-bottom: 64px; background: var(--bg-alt); min-height: 70vh; }
  .card { max-width: 460px; margin: 0 auto; background: var(--bg-white); border: 1px solid var(--border-soft); border-radius: 12px; padding: 24px; }
  h1 { font-size: 22px; margin-bottom: 16px; }
  dl { margin: 0 0 16px; }
  dl > div { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; font-size: 14px; border-bottom: 1px solid var(--border-soft); }
  dt { color: var(--text-muted); } dd { margin: 0; text-align: right; font-weight: 600; }
  .note { font-size: 13px; color: var(--text-muted); line-height: 1.7; margin-bottom: 12px; }
  .btn { display: block; text-align: center; margin-top: 16px; padding: 12px; border-radius: 10px; background: var(--brand-green); color: var(--text-light); text-decoration: none; font-weight: 600; }
</style>
