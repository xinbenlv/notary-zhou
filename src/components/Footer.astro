---
// Bilingual statutory notice, fee display and service boundaries.
// Length rationale: keep the paired legally required notices and shared footer together.
import { siteConfig } from '../config';
import { langPath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = {
  en: {
    disclaimerTitle: 'Disclaimer',
    usCnTitle: 'California notarization & documents used abroad',
    feesTitle: 'Fees',
  },
  zh: {
    disclaimerTitle: '免责声明 · Disclaimer',
    usCnTitle: '加州公证与跨境文件',
    feesTitle: '收费标准',
  },
}[lang];

const noticeEn =
  'I am not an attorney and, therefore, cannot give legal advice about immigration or any other legal matters.';
const noticeZh =
  '本人不是律师，因此不能就移民或任何其他法律事务提供法律意见。';

const commissionedEn = `${siteConfig.owner.fullNameEn} is a notary public commissioned by the Secretary of State of the State of California, United States of America ("California"), Commission ${siteConfig.commissionNumber}, governed by California law (Government Code sections 8200–8230 and related statutes).`;
const draftEn = `Once commissioned, ${siteConfig.owner.fullNameEn} will serve as a notary public commissioned by the Secretary of State of the State of California, United States of America ("California"), governed by California law (Government Code sections 8200–8230 and related statutes).`;
const commissionedZh = `${siteConfig.owner.nameZhDisplay} 是由美利坚合众国加利福尼亚州（通称“加州”）州务卿（Secretary of State）委任的公证员（Notary Public，委任编号 ${siteConfig.commissionNumber}，有效期至${siteConfig.commissionExpiresZh}），受《加州政府法典》第 8200–8230 条及相关法律约束。`;
const draftZh = `${siteConfig.owner.nameZhDisplay} 取得资格后，将作为由美利坚合众国加利福尼亚州（通称“加州”）州务卿（Secretary of State）委任的公证员（Notary Public）执业，受《加州政府法典》第 8200–8230 条及相关法律约束。`;
---

<footer>
  <div class="container">
    <div class="footer-disclaimer">
      <h3 class="disclaimer-title">{t.disclaimerTitle}</h3>
      <!-- Required notice — Cal. Gov. Code §8219.5 (non-attorney advertising in a
           language other than English; must appear in English and that language).
           On the Chinese page this notice therefore stays bilingual. -->
      <div class="disclaimer-notice">
        {lang === 'en' ? (
          <p>{noticeEn}</p>
        ) : (
          <>
            <p>{noticeEn}</p>
            <p lang="zh">{noticeZh}</p>
          </>
        )}
      </div>

      <div class="disclaimer-section">
        <h4>{t.usCnTitle}</h4>
        {lang === 'en' ? (
          <>
            <p>{siteConfig.isDraft ? draftEn : commissionedEn}</p>
            <p>
              In a California acknowledgment, the signer appears and acknowledges
              having signed the document; a jurat requires signing before the notary
              and an oath or affirmation. Neither certifies the document’s truthfulness,
              accuracy or validity. See <a href="/articles/acknowledgment-vs-jurat/">acknowledgment and jurat requirements (Chinese)</a>.
              For use abroad, confirm the recipient’s notarization, translation and
              authentication requirements before proceeding. Start with our
              <a href="/articles/topics/apostille/">cross-border document guides (Chinese)</a>.
            </p>
          </>
        ) : (
          <>
            <p lang="zh">{siteConfig.isDraft ? draftZh : commissionedZh}</p>
            <p lang="zh">
              在加州办理签名确认时，签署人须本人到场确认已签署文件；办理 jurat 时，还须当面签署并宣誓或郑重确认。两种公证均不证明文件的真实性、准确性或有效性，具体区别见<a href="/articles/acknowledgment-vs-jurat/">签名确认与宣誓书公证指南</a>。文件用于境外时，请先向接收机构确认公证、翻译和认证要求，再查阅<a href="/articles/topics/apostille/">跨境文件指南</a>。
            </p>
          </>
        )}
      </div>

      <div class="disclaimer-section">
        <h4>{t.feesTitle}</h4>
        {lang === 'en' ? (
          <p>
            Notarial fees follow the maximum fees set by California law (<a
              href={siteConfig.feeStatuteUrl}
              target="_blank"
              rel="noopener noreferrer">Cal. Gov. Code &sect;8211</a
            >), currently:
          </p>
        ) : (
          <p lang="zh">
            公证费按加州法律（<a
              href={siteConfig.feeStatuteUrl}
              target="_blank"
              rel="noopener noreferrer">《加州政府法典》第 8211 条</a
            >）规定的法定上限收取，现行标准如下：
          </p>
        )}
        <!-- Fee schedule is part of the §8219.5 notice — bilingual on the Chinese page -->
        <ul>
          {siteConfig.fees.map((f) =>
            lang === 'en' ? (
              <li>
                {f.en} — {f.feeEn}
              </li>
            ) : (
              <li>
                {f.en} {f.zh} — {f.fee}
              </li>
            )
          )}
        </ul>
        {lang === 'en' ? (
          <>
            <p>
              No notarial fee is charged for signatures on vote-by-mail ballot
              identification envelopes or other voting materials, or for the specified
              applications and claims for U.S. military veterans’ benefits. Further
              restrictions apply to services connected with covered veteran benefit matters; see our
              <a href="/articles/california-notary-fees/#ref-veterans">fee guide (Chinese)</a>.
              We check the applicable no-fee requirements before quoting related
              charges, including travel. These statutory maximums were verified on
              {siteConfig.feesLastVerified}; the current statute controls.
            </p>
            <p>
              <strong>Mobile service:</strong> Mandarin-speaking appointments in
              Santa Clara, San Mateo and Alameda counties; no walk-in office.
              Where a travel charge is permitted, it is quoted separately and agreed
              upon before booking. The estimate uses round-trip drive time from
              {siteConfig.travelOriginEn} to the signing location, at a price
              comparable to an Uber/Lyft ride. Confirm the total before the trip;
              a travel charge does not override statutory free-service requirements.
            </p>
          </>
        ) : (
          <>
            <p lang="zh">
              邮寄选票身份信封及其他投票材料上的签名公证，以及美国退伍军人的法定福利申请或索赔公证，不收公证费。<a href="/articles/california-notary-fees/#ref-veterans">相关退伍军人福利事项的其他服务</a>也有收费限制。报价前须核对适用的免费规定，包括交通费是否可以收取。以上法定上限核对日期为{siteConfig.feesLastVerifiedZh}；如法规修订，以现行规定为准。
            </p>
            <p lang="zh">
              <strong>上门服务：</strong>目前提供 Santa Clara、San Mateo、Alameda 三县的普通话预约制上门公证，不设到访接待办公室。在允许收取交通费的情形下，交通费单独报价，预约前确认；按从{siteConfig.travelOriginZh}至签署地点的往返时间预估，价格与 Uber/Lyft 近似。请在出发前确认总价；不能通过另列交通费绕过法定免费要求。
            </p>
          </>
        )}
      </div>
    </div>

    <a href={langPath(lang)} class="logo footer-logo">
      {siteConfig.name} <span class="logo-dot"></span>
    </a>

    <p class="footer-text">
      {siteConfig.owner.fullNameEn} &bull;
      {lang === 'en'
        ? siteConfig.isDraft
          ? 'Notary commission application pending — not yet commissioned'
          : `California Notary Public, Commission ${siteConfig.commissionNumber} (${siteConfig.commissionCounty} County) · Expires ${siteConfig.commissionExpiresEn}`
        : siteConfig.isDraft
          ? '公证员资格申请审核中，尚未取得资格'
          : `加州公证员 · 委任编号 ${siteConfig.commissionNumber}（${siteConfig.commissionCounty} 县）· 有效期至${siteConfig.commissionExpiresZh}`}<br />
      &copy; {siteConfig.copyrightYear} NotaryZhou.com. All rights reserved.
    </p>
    <p class="footer-text" style="margin-top: 16px;">
      <a href={`${langPath(lang)}privacy/`}>
        {lang === 'en' ? 'Privacy & cookies' : '隐私与 Cookie 说明'}
      </a>
    </p>
  </div>
</footer>
