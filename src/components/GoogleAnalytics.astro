<!-- Basic page statistics for the production website. -->
<script is:inline>
  (() => {
    if (location.hostname !== 'www.notaryzhou.com' || window.__notaryZhouAnalytics) return;
    window.__notaryZhouAnalytics = true;

    const measurementId = 'G-NSPEQT81PG';
    // Lookup inputs can occur in query strings. Send only the origin and path.
    const withoutQuery = (value) => {
      try {
        const url = new URL(value);
        return url.origin + url.pathname;
      } catch {
        return '';
      }
    };

    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    window.gtag('js', new Date());
    // config sends the single initial page_view; do not send another manually.
    window.gtag('config', measurementId, {
      page_location: withoutQuery(location.href),
      page_referrer: withoutQuery(document.referrer),
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
    });

    // Count an intentional inquiry click, not an email sent or a booking made.
    // Only explicitly marked business-contact links qualify. Never send the
    // link URL, address, text, lookup input, or form contents as event data.
    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || !(event.target instanceof Element)) return;
      const link = event.target.closest('a[data-contact-method="email"]');
      if (!link || !link.getAttribute('href')?.startsWith('mailto:')) return;
      if (link.dataset.contactPlacement !== 'booking') return;
      window.gtag('event', 'contact_email_click', {
        contact_method: 'email',
        contact_placement: 'booking',
        transport_type: 'beacon',
      });
    });

    const script = document.createElement('script');
    script.async = true;
    script.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
    document.head.appendChild(script);
  })();
</script>
