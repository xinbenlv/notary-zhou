---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import InterfaceText from './InterfaceText.astro';
import ArticleDisclaimer from './ArticleDisclaimer.astro';
import ArticleReferences from './ArticleReferences.astro';
import ArticleRelated from './ArticleRelated.astro';
import { siteConfig } from '../config';
import { langPath } from '../i18n';
import { articleCategories, articlePath, articleIndexPath, formatDate, type Article } from '../articles';
interface Props { article: Article }
const { article } = Astro.props;
const { Content } = await render(article);
const d = article.data;
const lang = d.lang;
const published = await getCollection('articles', ({ data }) => !data.draft);
const path = articlePath(article);
const canonical = `${siteConfig.url}${path}`;
const index = articleIndexPath(lang);
const label = '公证知识';
const ogImage = d.cover ? `${siteConfig.url}${d.cover}` : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [{
    '@type': 'Article', headline: d.title, description: d.description,
    inLanguage: 'zh-CN',
    datePublished: d.pubDate.toISOString().slice(0, 10),
    ...(d.updatedDate ? { dateModified: d.updatedDate.toISOString().slice(0, 10) } : {}),
    ...(ogImage ? { image: ogImage } : {}), mainEntityOfPage: canonical,
    author: { '@type': 'Person', name: siteConfig.owner.nameZhDisplay, url: siteConfig.url },
    publisher: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.url },
  }, {
    '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: siteConfig.name, item: `${siteConfig.url}${langPath(lang)}` },
      { '@type': 'ListItem', position: 2, name: label, item: `${siteConfig.url}${index}` },
      { '@type': 'ListItem', position: 3, name: d.title, item: canonical },
    ],
  }],
};
---
<ArticleLayout title={`${d.title} | ${siteConfig.name}`} description={d.description}
  path={path} ogImage={ogImage} ogType="article" jsonLd={jsonLd}>
  <main class="article-page" data-testid="article-page">
    <div class="container"><div class="article-wrap">
      <p class="article-meta">
        <a href={index}><InterfaceText zh={label} en="Articles" /></a><span>·</span>
        <InterfaceText zh={articleCategories[d.category].zh} en={articleCategories[d.category].en} />
        <span>·</span><InterfaceText
          zh={`${d.updatedDate ? '更新：' : ''}${formatDate(d.updatedDate ?? d.pubDate, 'zh')}`}
          en={`${d.updatedDate ? 'Updated: ' : ''}${formatDate(d.updatedDate ?? d.pubDate, 'en')}`} />
      </p>
      <p data-article-ui="en" lang="en" class="article-meta">This article is available in Chinese.</p>
      <h1 lang="zh-CN" data-article-content>{d.title}</h1>
      <p class="article-desc" lang="zh-CN" data-article-content>{d.description}</p>
      {d.cover && <img class="article-cover" src={d.cover} alt={d.coverAlt ?? d.title} width={d.coverWidth} height={d.coverHeight} fetchpriority="high" />}
      <article class="article-body" lang="zh-CN"><Content /></article>
      <ArticleRelated article={article} articles={published} />
      <ArticleDisclaimer />
      <div class="article-cta">
        <div>
          <h3><InterfaceText zh="需要湾区中文上门公证？" en="Need a Mandarin-speaking mobile notary in the Bay Area?" /></h3>
          <p><InterfaceText zh="服务范围：Santa Clara、San Mateo、Alameda 三县。跨境文件请先向接收方核实要求。" en="Serving Santa Clara, San Mateo and Alameda counties. Confirm cross-border document requirements with the recipient first." /></p>
        </div>
        <a href="/#book" data-interface-href-zh="/#book" data-interface-href-en="/en/#book" class="btn btn-yellow"><InterfaceText zh="联系预约" en="Contact & booking" /></a>
      </div>
      <p class="article-back"><a href={index}><InterfaceText zh="← 返回公证知识" en="← All articles" /></a></p>
    </div></div>
  </main>
  <ArticleReferences />
</ArticleLayout>
