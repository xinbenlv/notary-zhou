---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import ArticleDisclaimer from './ArticleDisclaimer.astro';
import ArticleReferences from './ArticleReferences.astro';
import ArticleRelated from './ArticleRelated.astro';
import { siteConfig } from '../config';
import { langPath, otherLang } from '../i18n';
import { articleCategories, articlePath, articleIndexPath, articleAlternates, formatDate, type Article } from '../articles';
interface Props { article: Article }
const { article } = Astro.props;
const { Content } = await render(article);
const d = article.data;
const lang = d.lang;
const published = await getCollection('articles', ({ data }) => !data.draft);
const alternates = articleAlternates(article, published);
const path = articlePath(article);
const canonical = `${siteConfig.url}${path}`;
const index = articleIndexPath(lang);
const label = lang === 'zh' ? '公证知识' : 'Notary & document guides';
const ogImage = d.cover ? `${siteConfig.url}${d.cover}` : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [{
    '@type': 'Article', headline: d.title, description: d.description,
    inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
    datePublished: d.pubDate.toISOString().slice(0, 10),
    ...(d.updatedDate ? { dateModified: d.updatedDate.toISOString().slice(0, 10) } : {}),
    ...(ogImage ? { image: ogImage } : {}), mainEntityOfPage: canonical,
    author: { '@type': 'Person', name: siteConfig.owner.nameZhDisplay, url: siteConfig.url },
    publisher: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.url },
  }, {
    '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: siteConfig.name, item: `${siteConfig.url}${langPath(lang)}` },
      { '@type': 'ListItem', position: 2, name: label, item: `${siteConfig.url}${index}` },
      { '@type': 'ListItem', position: 3, name: d.title, item: canonical },
    ],
  }],
};
---
<Layout lang={lang} title={`${d.title} | ${siteConfig.name}`} description={d.description}
  path={path} ogImage={ogImage} ogType="article" jsonLd={jsonLd} alternatePaths={alternates}>
  <Navbar lang={lang} alternateHref={alternates?.[otherLang(lang)] ?? articleIndexPath(otherLang(lang))} />
  <main class="article-page" data-testid="article-page">
    <div class="container"><div class="article-wrap">
      <p class="article-meta">
        <a href={index}>{label}</a><span>·</span><span>{articleCategories[d.category][lang]}</span>
        <span>·</span><span>{d.updatedDate ? (lang === 'zh' ? '更新：' : 'Updated: ') : ''}{formatDate(d.updatedDate ?? d.pubDate, lang)}</span>
      </p>
      <h1>{d.title}</h1>
      <p class="article-desc">{d.description}</p>
      {d.cover && <img class="article-cover" src={d.cover} alt={d.coverAlt ?? d.title} width={d.coverWidth} height={d.coverHeight} fetchpriority="high" />}
      <article class="article-body" lang={lang === 'zh' ? 'zh-CN' : 'en'}><Content /></article>
      <ArticleRelated article={article} articles={published} />
      <ArticleDisclaimer lang={lang} />
      <div class="article-cta">
        <div>
          <h3>{lang === 'zh' ? '需要湾区中文上门公证？' : 'Need a Mandarin-speaking mobile notary in the Bay Area?'}</h3>
          <p>{lang === 'zh' ? '服务范围：Santa Clara、San Mateo、Alameda 三县。跨境文件请先向接收方核实要求。' : 'Mandarin service in Santa Clara, San Mateo and Alameda counties. Check cross-border document requirements with the recipient first.'}</p>
        </div>
        <a href={`${langPath(lang)}#book`} class="btn btn-yellow">{lang === 'zh' ? '联系预约' : 'Contact & booking'}</a>
      </div>
      <p class="article-back"><a href={index}>{lang === 'zh' ? '← 返回公证知识' : '← All guides'}</a></p>
    </div></div>
  </main>
  <Footer lang={lang} />
  <ArticleReferences />
</Layout>
