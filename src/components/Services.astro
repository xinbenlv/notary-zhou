---
import { siteConfig } from '../config';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = {
  en: {
    heading: 'What document are you notarizing?',
    mobileTitle: 'Need Mobile Service?',
    mobileDesc: `We travel to your home, office, hospital, or coffee shop in ${siteConfig.serviceAreas.join(', ')} counties.`,
    mobileCta: 'Check Travel Fees',
  },
  zh: {
    heading: '您需要公证什么文件？',
    mobileTitle: '需要上门服务？',
    mobileDesc: `我们可前往您位于 ${siteConfig.serviceAreas.join('、')} 县的家中、办公室、医院或咖啡厅。`,
    mobileCta: '查看交通费',
  },
}[lang];

const cards = [
  {
    titleEn: 'Acknowledgments',
    titleZh: '签名确认公证',
    descEn: "Deeds, trusts, and agreements confirming the signer's identity and willingness.",
    descZh: '地契、信托及各类协议——确认签署人身份及自愿签署。',
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline>',
  },
  {
    titleEn: 'Jurats',
    titleZh: '宣誓书公证',
    descEn: 'Affidavits and depositions requiring you to swear or affirm the truth of the document.',
    descZh: '宣誓书及证词文件——需当面宣誓或确认文件内容属实。',
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>',
  },
  {
    titleEn: 'Copy Certification',
    titleZh: '副本认证',
    descEn: 'Certifying that a copy of an original document is a true, exact, and complete reproduction (Power of Attorney only in CA).',
    descZh: '证明副本与原件完全一致（加州法律仅限授权委托书 Power of Attorney）。',
    icon: '<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>',
  },
  {
    titleEn: 'Real Estate / Loan',
    titleZh: '房产/贷款文件',
    descEn: 'Refinances, buyer/seller packages, HELOCs, and commercial real estate documents.',
    descZh: '重新贷款、买卖文件包、房屋净值贷款（HELOC）及商业地产文件。',
    icon: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline>',
  },
  {
    titleEn: 'Apostille Processing',
    titleZh: '海牙认证代办',
    descEn: 'Assistance with California Secretary of State authentication for international documents.',
    descZh: '协助办理加州州务卿的海牙认证（Apostille），用于国际文件。',
    icon: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>',
  },
];
---

<section id="services" class="services-section">
  <div class="container">
    <div class="section-header">
      <h2>{t.heading}</h2>
    </div>

    <div class="services-grid">
      {cards.map((card) => (
        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={card.icon} />
          </div>
          <div class="service-content">
            <h3 class="lang-en">{lang === 'en' ? card.titleEn : card.titleZh}</h3>
            <p style="margin-top: 8px;">{lang === 'en' ? card.descEn : card.descZh}</p>
          </div>
        </div>
      ))}

      <!-- Mobile Service CTA -->
      <div class="service-card service-card-green">
        <div class="service-icon" style="background-color: rgba(255,255,255,0.1); border: none;">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </div>
        <div class="service-content">
          <h3 style="color: white;">{t.mobileTitle}</h3>
          <p style="color: rgba(255,255,255,0.8); margin-top: 8px; margin-bottom: 16px;">
            {t.mobileDesc}
          </p>
          <a href="#book" style="color: var(--brand-yellow); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 4px;">
            {t.mobileCta} <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
