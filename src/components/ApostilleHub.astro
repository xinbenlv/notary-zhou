---
import { getCollection } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import InterfaceText from './InterfaceText.astro';
import { apostilleKeys, articleKey, articlePath, articleIndexPath, topicPath } from '../articles';
interface Props { lang: 'zh' }
const { lang } = Astro.props;
const articles = await getCollection('articles', ({ data }) => !data.draft && data.lang === lang);
const guides = apostilleKeys.map(key => articles.find(a => articleKey(a) === key)).filter(Boolean);
const title = '海牙认证与跨境文件指南';
const description = '从文件签发地、使用地和接收机构开始，找到出生证明、结婚证、单身声明、同一人声明与委托书的办理指南。';
const steps = [
  ['文件在哪里签发？', '记下国家、州或省，以及文件上的签发机构与签字人。', 'Where was it issued?', 'Note the country, state or province, issuing office and signing official.'],
  ['交给哪里、哪家机构？', '向接收机构索取现行清单：文件版本、翻译、有效期及认证要求。', 'Who will receive it?', 'Ask the recipient for its current checklist: document version, translation, age limits and authentication requirements.'],
  ['你手里是哪一种文件？', '出生证明和个人声明是不同类型。选择下方对应指南，再核对其中的官方来源。', 'What document do you have?', 'Choose the corresponding Chinese guide below, then check its official sources.'],
];
---
<ArticleLayout title={`${title} | Notary Zhou`} description={description} path={topicPath(lang)}
  jsonLd={{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description,
    url: `https://www.notaryzhou.com${topicPath(lang)}`, inLanguage: 'zh-CN' }}>
  <main class="articles-index" data-testid="article-directory"><div class="container">
    <header class="articles-hero">
      <p class="eyebrow"><InterfaceText zh="跨境文件 · 办理前的第一步" en="CROSS-BORDER DOCUMENTS · START HERE" /></p>
      <h1><InterfaceText zh={title} en="Apostille & cross-border document guides" /></h1>
      <p><InterfaceText zh={description} en="Find your document type below. All articles are in Chinese, with links to official sources." /></p>
    </header>
    <ol class="starting-points">{steps.map(([heading, copy, headingEn, copyEn]) => <li><h2><InterfaceText zh={heading} en={headingEn} /></h2><p><InterfaceText zh={copy} en={copyEn} /></p></li>)}</ol>
    <section class="articles-group">
      <h2><InterfaceText zh="按文件类型继续" en="Choose your document" /></h2>
      <div class="articles-grid">{guides.map(a => a && <a class="article-card" data-testid="article-card" href={articlePath(a)}>
        {a.data.cover && <img src={a.data.cover} alt={a.data.coverAlt ?? a.data.title} width="1200" height="630" loading="lazy" />}
        <div class="article-card-body" lang="zh-CN" data-article-content><h3>{a.data.title}</h3><p>{a.data.description}</p></div>
      </a>)}</div>
    </section>
    <p class="scope-note"><InterfaceText zh="这里汇集办理前的参考资讯；各篇标明适用地区。Notary Zhou 的实际公证服务为旧金山湾区三县的普通话上门服务。" en="Each article identifies the jurisdictions it covers. Notary Zhou provides Mandarin-speaking mobile notarization in three San Francisco Bay Area counties." /></p>
    <p class="article-back"><a href={articleIndexPath(lang)}><InterfaceText zh="查看全部公证知识 →" en="Browse all Chinese articles →" /></a></p>
  </div></main>
</ArticleLayout>
<style>
  h1 { text-wrap: balance; }
  .eyebrow { font-size: 13px; letter-spacing: .08em; color: var(--brand-green); margin-block-end: 20px; }
  .starting-points { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; padding: 0; list-style: none; counter-reset: step; margin-block: 40px 64px; }
  .starting-points li { border-block-start: 2px solid var(--brand-green); padding-block-start: 24px; counter-increment: step; }
  .starting-points li::before { content: '0' counter(step); color: var(--brand-green); font-size: 32px; font-weight: 600; }
  .starting-points h2 { font-size: 22px; margin-block: 12px; }
  .starting-points p, .scope-note { color: var(--text-muted); line-height: 1.8; }
  .scope-note { max-width: 760px; margin-block: 40px 20px; }
  @media (max-width: 700px) { .starting-points { grid-template-columns: 1fr; gap: 24px; } }
</style>
