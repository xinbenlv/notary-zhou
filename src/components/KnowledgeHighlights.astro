---
import { articleIndexPath, topicPath } from '../articles';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="knowledge-highlights"><div class="container">
  <h2>{lang === 'zh' ? '文件跨境使用，从这里了解' : 'Chinese document guides'}</h2>
  <p>{lang === 'zh' ? '海牙认证、出生证明、结婚证与个人声明：先了解文件类别和接收方要求，再决定下一步。' : 'Explore our Chinese-language articles on notarization and cross-border documents, with links to official sources.'}</p>
  <div class="guide-links">
    <a href={topicPath(lang)}>{lang === 'zh' ? '海牙认证与跨境文件指南 →' : 'Apostille & cross-border documents →'}</a>
    <a href={articleIndexPath(lang)}>{lang === 'zh' ? '全部公证知识 →' : 'All Chinese articles →'}</a>
  </div>
</div></section>
<style>
  .knowledge-highlights { padding-block: 64px; background: var(--bg-alt); }
  h2 { color: var(--brand-green); font-size: clamp(26px, 4vw, 36px); margin-block-end: 16px; }
  p { max-width: 720px; color: var(--text-muted); line-height: 1.8; }
  .guide-links { display: flex; flex-wrap: wrap; gap: 20px 32px; margin-block-start: 24px; }
  a { color: var(--brand-green); text-decoration: underline; text-underline-offset: 4px; padding-block: 8px; }
</style>
